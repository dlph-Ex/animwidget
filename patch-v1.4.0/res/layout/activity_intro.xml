<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 流动背景：自绘极光渐变，整层 100% 高斯模糊（API31+ RenderEffect，低版本降采样堆叠） -->
    <io.github.animwidget.AuroraView android:id="@+id/intro_aurora"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- 压暗层：保证文字对比度（自绘，颜色按主题） -->
    <View android:id="@+id/intro_scrim"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="62dp" android:paddingBottom="130dp"
            android:paddingStart="24dp" android:paddingEnd="24dp">

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/intro_kicker" android:textSize="12sp"
                    android:letterSpacing="0.14" android:textAllCaps="false"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="@string/intro_kicker" />
                <TextView android:id="@+id/intro_skip" android:textSize="13sp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:paddingStart="10dp" android:paddingEnd="4dp"
                    android:clickable="true" android:focusable="true"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/intro_skip" />
            </LinearLayout>

            <TextView android:id="@+id/intro_title" android:textSize="34sp"
                android:textStyle="bold" android:lineSpacingExtra="4dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="@string/intro_title" />

            <TextView android:id="@+id/intro_sub" android:textSize="13sp" android:tag="muted"
                android:lineSpacingExtra="3dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/intro_sub" />

            <LinearLayout android:id="@+id/intro_glass" android:orientation="vertical"
                android:tag="card" android:paddingTop="6dp" android:paddingBottom="6dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="26dp">

                <LinearLayout android:id="@+id/intro_feat_host" android:orientation="vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView android:id="@+id/intro_badge" android:textSize="11sp" android:tag="muted"
                android:gravity="center" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp" />
        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/intro_cta" android:tag="primary"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:layout_marginBottom="28dp"
        android:textSize="16sp" android:textAllCaps="false"
        android:text="@string/intro_cta" />
</FrameLayout>
